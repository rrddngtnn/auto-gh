# Proxy driver: template | file | single | direct
PROXY_DRIVER=template
PROXY_HOST=proxy.example.test
PROXY_USER=proxy_user
PROXY_PASS=proxy_pass
PROXY_PORT_MIN=10000
PROXY_PORT_MAX=29999
PROXY_TEMPLATE=http://{user}__cr.{country};sessttl.{ttl}:{password}@{host}:{port}
# Optional static proxy list file (.txt or .json) or single proxy URL
PROXY_FILE=
PROXY_URL=

# Mailbox driver: forwarded_rest | rest | imap | sqlite | manual
MAILBOX_DRIVER=forwarded_rest
MAILBOX_API_URL=http://127.0.0.1:8789
MAILBOX_DB_PATH=./inbox.db
CATCHALL_MASTER_ADDRESS=master@example.test
CATCHALL_MASTER_TOKEN=master_token_placeholder
IMAP_HOST=imap.example.test
IMAP_USER=catchall@example.test
IMAP_PASS=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
CATCHALL_DOMAINS=alpha.example.test,beta.example.test

# Optional BYOP panel auth & custom downstream pipe commands
PANEL_AUTH_TOKEN=
PAIR_KIRO_CMD=
PAIR_CBAI_CMD=
